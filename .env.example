# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Get a real Gemini key from https://aistudio.google.com/app/apikey.
GEMINI_API_KEY=
GEMINI_FAST_MODEL=gemini-3.8-flash
GEMINI_STRONG_MODEL=gemini-3.1-pro-preview

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# TELEGRAM BOT CONFIGURATION FOR WEBAPP AUTHENTICATION
# The bot token provided by @BotFather. Used for server-side HMAC validation of Telegram.WebApp.initData
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_WEBAPP_URL=https://dastyorchi.vercel.app

# Optional comma-separated list of Telegram User IDs who have admin privileges
ADMIN_TELEGRAM_IDS=
ADMIN_UIDS=

# Cryptographic signing secret for generated user session tokens (required in production)
SESSION_SECRET=

# FIREBASE CREDENTIALS FOR PRODUCTION (VERCEL / CLOUD)
# JSON string of Firebase service account key credentials for privileged backend operations
FIREBASE_SERVICE_ACCOUNT_KEY=
# Fallback Firebase Project ID
FIREBASE_PROJECT_ID=dastyorchi

# FIREBASE WEB CLIENT CONFIGURATION (PROJECT: dastyorchi)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=dastyorchi.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=dastyorchi
VITE_FIREBASE_STORAGE_BUCKET=dastyorchi.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# PAYME MERCHANTS CONFIGURATION

PAYME_MERCHANT_ID=
PAYME_MERCHANT_KEY=

# CLICK MERCHANT REVENUE SETTINGS
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_MERCHANT_KEY=
