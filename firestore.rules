rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for authorization
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        ('role' in request.auth.token && request.auth.token.role == 'admin') ||
        ('admin' in request.auth.token && request.auth.token.admin == true)
      );
    }

    // 1. Users Profile & subcollections
    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow create: if isSignedIn() && (
        isAdmin() ||
        (
          request.auth.uid == userId &&
          request.resource.data.get('role', 'user') == 'user' &&
          request.resource.data.get('admin', false) == false &&
          request.resource.data.get('subscriptionTier', 'free') == 'free' &&
          request.resource.data.get('subscriptionStatus', 'active') == 'active' &&
          request.resource.data.get('aiCreditsDailyLimit', 10) <= 10 &&
          request.resource.data.get('aiCreditsRemaining', 10) <= 10 &&
          request.resource.data.get('blocked', false) == false
        )
      );
      allow update: if isSignedIn() && (
        isAdmin() ||
        (
          request.auth.uid == userId &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'displayName', 'firstName', 'lastName', 'username',
            'avatarUrl', 'photoUrl', 'language', 'languageCode',
            'theme', 'preferences', 'updatedAt'
          ])
        )
      );
      allow delete: if isAdmin();

      match /notifications/{notificationId} {
        allow read, write: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      }

      match /{allSubcollections=**} {
        allow read, write: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      }
    }

    // 2. Chat Sessions & Messages
    match /chats/{chatId} {
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow read, delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow update: if isSignedIn() && (
        isAdmin() ||
        (resource.data.userId == request.auth.uid && request.resource.data.userId == resource.data.userId)
      );

      match /messages/{messageId} {
        allow create: if isSignedIn() && (
          get(/databases/$(database)/documents/chats/$(chatId)).data.userId == request.auth.uid || isAdmin()
        );
        allow read, update, delete: if isSignedIn() && (
          get(/databases/$(database)/documents/chats/$(chatId)).data.userId == request.auth.uid || isAdmin()
        );
      }

      match /{allSubcollections=**} {
        allow read, write: if isSignedIn() && (
          get(/databases/$(database)/documents/chats/$(chatId)).data.userId == request.auth.uid || isAdmin()
        );
      }
    }

    // 3. Legal Cases & Subcollections
    match /cases/{caseId} {
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow read, delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow update: if isSignedIn() && (
        isAdmin() ||
        (resource.data.userId == request.auth.uid && request.resource.data.userId == resource.data.userId)
      );

      match /{allSubcollections=**} {
        allow read, write: if isSignedIn() && (
          get(/databases/$(database)/documents/cases/$(caseId)).data.userId == request.auth.uid || isAdmin()
        );
      }
    }

    // 4. Person / Client Profiles
    match /profiles/{profileId} {
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow read, delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow update: if isSignedIn() && (
        isAdmin() ||
        (resource.data.userId == request.auth.uid && request.resource.data.userId == resource.data.userId)
      );
    }

    // 5. Generated Legal Documents
    match /documents/{docId} {
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow read, delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow update: if isSignedIn() && (
        isAdmin() ||
        (resource.data.userId == request.auth.uid && request.resource.data.userId == resource.data.userId)
      );
    }

    // 6. Archived Documents & Chats
    match /archived_documents/{docId} {
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow read, delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow update: if isSignedIn() && (
        isAdmin() ||
        (resource.data.userId == request.auth.uid && request.resource.data.userId == resource.data.userId)
      );
    }
    match /archived_chats/{chatId} {
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow read, delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow update: if isSignedIn() && (
        isAdmin() ||
        (resource.data.userId == request.auth.uid && request.resource.data.userId == resource.data.userId)
      );

      match /{allSubcollections=**} {
        allow read, write: if isSignedIn() && (
          get(/databases/$(database)/documents/archived_chats/$(chatId)).data.userId == request.auth.uid || isAdmin()
        );
      }
    }
    match /archived_messages/{messageId} {
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow read, delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow update: if isSignedIn() && (
        isAdmin() ||
        (resource.data.userId == request.auth.uid && request.resource.data.userId == resource.data.userId)
      );
    }

    // 7. Internal System Settings, Plans & Quota Limits
    match /internal/{docId=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 8. System Announcements
    match /announcements/{annId=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 9. Payment Requests
    match /paymentRequests/{requestId} {
      allow read: if isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        resource.data.uid == request.auth.uid ||
        isAdmin()
      );
      allow create: if isSignedIn() && (
        (request.resource.data.userId == request.auth.uid || request.resource.data.uid == request.auth.uid) &&
        request.resource.data.status == 'pending'
      );
      allow update, delete: if isAdmin();
    }

    // 9a. Authoritative Payment Orders (Server-only write)
    match /payment_orders/{orderId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if false; // Server-only via Express backend / Firebase Admin
    }

    // 9b. Financial Provider Transactions (Server-only write)
    match /paymeTransactions/{txnId} {
      allow read: if isAdmin();
      allow write: if false; // Server-only via Express backend
    }
    match /clickTransactions/{txnId} {
      allow read: if isAdmin();
      allow write: if false; // Server-only via Express backend
    }

    // 10. Legal Articles Public Library (Read-only for public, admin write)
    match /legal_articles/{articleId=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 11. Activities & Audit Logs
    match /activities/{activityId} {
      allow read, delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() && (
        isAdmin() ||
        (resource.data.userId == request.auth.uid && request.resource.data.userId == resource.data.userId)
      );
    }

    // 12. Conversions & Translations History
    match /conversions/{conversionId} {
      allow read, delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() && (
        isAdmin() ||
        (resource.data.userId == request.auth.uid && request.resource.data.userId == resource.data.userId)
      );
    }

    // 13. Legal Research Reports
    match /research_reports/{reportId} {
      allow read, delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() && (
        isAdmin() ||
        (resource.data.userId == request.auth.uid && request.resource.data.userId == resource.data.userId)
      );
    }

    // 14. System Logs (allow clients to submit live error logs)
    match /system_logs/{logId} {
      allow create: if isSignedIn();
      allow read, update, delete: if isAdmin();
    }

    // 15. Server-Authoritative AI Usage Ledger
    match /ai_usage/{requestId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if false; // Server-only via Firebase Admin SDK
    }

    // 15a. Server-Authoritative AI Request Idempotency Ledger
    match /ai_requests/{clientRequestId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if false; // Server-only via Firebase Admin SDK
    }

    // 16. Admins
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
  }
}
