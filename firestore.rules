rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Users Profile
    match /users/{userId} {
      allow read, write: if true;
    }

    // 2. Chat Sessions
    match /chats/{chatId} {
      allow read, write: if true;
      match /messages/{messageId} {
        allow read, write: if true;
      }
    }

    // 3. Legal Cases
    match /cases/{caseId} {
      allow read, write: if true;
      match /messages/{messageId} {
        allow read, write: if true;
      }
      match /evidence/{evidenceId} {
        allow read, write: if true;
      }
      match /evidenceReports/{reportId} {
        allow read, write: if true;
      }
      match /analysisMetrics/{metricId} {
        allow read, write: if true;
      }
    }

    // 4. Profiles
    match /profiles/{profileId} {
      allow read, write: if true;
    }

    // 5. Documents
    match /documents/{docId} {
      allow read, write: if true;
    }

    // 6. Archived Documents & Chats
    match /archived_documents/{docId} {
      allow read, write: if true;
    }
    match /archived_chats/{chatId} {
      allow read, write: if true;
      match /messages/{messageId} {
        allow read, write: if true;
      }
    }
    match /archived_messages/{messageId} {
      allow read, write: if true;
    }

    // 7. Internal Settings
    match /internal/{docId} {
      allow read, write: if true;
    }
    
    // 8. User-Scoped Notifications Alerts
    match /users/{userId}/notifications/{notificationId} {
      allow read, write: if true;
    }

    // 9. Announcements
    match /announcements/{annId} {
      allow read, write: if true;
    }

    // 10. Payment Requests
    match /paymentRequests/{requestId} {
      allow read, write: if true;
    }

    // 11. Legal Articles Source Database
    match /legal_articles/{articleId} {
      allow read, write: if true;
    }

    // 12. Activities Log
    match /activities/{activityId} {
      allow read, write: if true;
    }

    // 13. Language and Script Conversions History
    match /conversions/{conversionId} {
      allow read, write: if true;
    }

    // 14. Legal Research Reports
    match /research_reports/{reportId} {
      allow read, write: if true;
    }

    // 15. System Audit & Error Logs
    match /system_logs/{logId} {
      allow read, write: if true;
    }
  }
}



